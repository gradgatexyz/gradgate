# gradgate reads this file on start. The defaults are free public endpoints; swap in your own provider any time.

# calls: names, launch records, curve and pool quotes. public nodes rate-limit when the chain is busy:
# before trading live, use your own provider here (alchemy has a free tier: an app on Robinhood Chain, its HTTPS url)
RH_RPC=https://robinhood-rpc.publicnode.com
# event logs when the engine catches up (the first hour after a start, gaps)
RH_RPC_LOGS=https://rpc.mainnet.chain.robinhood.com
# the live feed: launches, every curve trade, new blocks
RH_WS=wss://robinhood-rpc.publicnode.com

# optional: keep the last 24 hours in postgres so a restart takes seconds instead of minutes
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gradgate

# paper fills land this long after a signal, for entries and exits alike
# PAPER_LATENCY_S=1.0

# ---- live trading: real money. leave RH_PRIVATE_KEY out and nothing can trade for real. ----
# use a fresh wallet that holds only what you can lose.
# RH_PRIVATE_KEY=0x...
# LIVE_MAX_SIZE=0.01
# LIVE_MAX_OPEN=3
# LIVE_DAILY_STOP=0.05
